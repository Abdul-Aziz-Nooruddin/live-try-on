{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "headless": true
  },
  "start_url": { "url": "https://www.vaniger.com/login" },
  "actions": [
    { "step_id": "login-settle", "action": "wait_for_timeout", "duration_ms": 1500 }
  ],
  "capture": {
    "at_end": ["dom", "accessibility", "url"],
    "events": ["network", "page-errors"]
  }
}
